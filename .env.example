# ============================================================================
# QuantPilot AI — Ortam Yapılandırma Şablonu (.env.example)
# ============================================================================
# Bu dosyayı .env olarak kopyalayın ve yalnızca PAPER (sanal) API anahtarlarınızı
# girin. ASLA gerçek (live) hesap anahtarlarınızı girmeyin.
# ============================================================================

# Alpaca Paper Trading API anahtarları (PK ile başlar)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ZORUNLU: QuantPilot AI yalnızca paper modda çalışır (false yapılırsa başlamaz)
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Veri akışı: ücretsiz planda anlık veri 'iex', >15 dk tarihsel veri 'sip'
ALPACA_DATA_FEED=iex
ALPACA_HISTORICAL_FEED=sip

# Başlangıç referans sanal bakiye (USD)
INITIAL_CAPITAL=100000

# Yerel Ollama AI (isteğe bağlı — çevrimdışıysa bot deterministik olarak çalışır)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=90

# Kayıt seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
